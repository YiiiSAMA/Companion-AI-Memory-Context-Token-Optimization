# Local proxy
MEMORY_HOST=127.0.0.1
MEMORY_PORT=8787
MEMORY_DB=./data/memory.db
MEMORY_PROXY_KEY=change-me

# Upstream OpenAI-compatible API
UPSTREAM_BASE_URL=https://api.deepseek.com/v1
UPSTREAM_API_KEY=sk-your-key
UPSTREAM_MODEL=deepseek-chat

# Context budget (prompt tokens, excluding reserved output)
MEMORY_MAX_PROMPT_TOKENS=6000
MEMORY_RESERVE_OUTPUT_TOKENS=800
MEMORY_RECENT_TURNS=8
MEMORY_TOP_K=6
MEMORY_MAX_MEMORY_TOKENS=1100

# Consolidation
MEMORY_ENABLE_FACT_EXTRACTION=1
MEMORY_ENABLE_CONSOLIDATION=1
MEMORY_CONSOLIDATION_THRESHOLD=30
MEMORY_CONSOLIDATION_BATCH=20
# extractive = zero extra model calls; llm = higher quality, extra upstream call
MEMORY_CONSOLIDATION_MODE=extractive
# MEMORY_SUMMARY_MODEL=deepseek-chat

# Markdown memory mirror
MEMORY_MARKDOWN_DIR=./data/memory-md
MEMORY_MARKDOWN_AUTO_EXPORT=0

MEMORY_SELF_CONTINUITY=1

MEMORY_SELF_INJECT_GAP_HOURS=6

MEMORY_SELF_NOTE_MAX_TOKENS=350

MEMORY_SELF_NOTE_STYLE=diary
